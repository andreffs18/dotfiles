#!/usr/bin/env bash

export DIRECTORY=~/.dotfiles
export APPLE_ID=andreffs18@gmail.com
export REPOSITORY=https://github.com/andreffs18/dotfiles

# Make vim the default editor.
export EDITOR='vim';

# Enable Colors
export CLICOLOR=1

# Increase Bash history size. Allow 32³ entries; the default is 500.
export HISTSIZE='32768';
export HISTFILESIZE="${HISTSIZE}";

# Prefer US English and use UTF-8.
export LANG='en_US.UTF-8';
export LC_ALL='en_US.UTF-8';

# In order to use GPG commit verification
# Referenced on issue https://github.com/keybase/keybase-issues/issues/2798
# To configure follow: https://github.com/pstadler/keybase-gpg-github
export GPG_TTY=$(tty)

# Configuration for all Executable Paths


log.success ".global_exports loaded with success!"
